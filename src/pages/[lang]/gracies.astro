---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { languages, t, type Lang } from "../../i18n/translations";
import "../../styles/global.css";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<Layout title={t(lang, "thanks.meta.title")} description={t(lang, "thanks.meta.description")} lang={lang}>
  <div class="min-h-screen flex flex-col">
  <Header lang={lang} />
  <main class="pt-32 pb-20 px-6 flex-1">
    <div class="max-w-xl mx-auto text-center">
      <h1 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">
        {t(lang, "thanks.title")}
      </h1>
      <p class="text-lg text-warm-500 mb-8">
        {t(lang, "thanks.description")}
      </p>
      <a
        href={`/${lang}/`}
        class="inline-block bg-brand-500 hover:bg-brand-600 text-white px-8 py-4 rounded-xl text-lg font-semibold transition-colors"
      >
        {t(lang, "thanks.back")}
      </a>
    </div>
  </main>
  <Footer lang={lang} />
  </div>
</Layout>
