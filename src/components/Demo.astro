---
import { t, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="demo" class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">
        {t(lang, "demo.title")}
      </h2>
      <p class="text-lg text-warm-500 max-w-2xl mx-auto">
        {t(lang, "demo.subtitle")}
      </p>
    </div>

    <!-- ==================== MOBILE: Phone mockup ==================== -->
    <div class="md:hidden mx-auto w-[320px]">
      <div class="rounded-[2.5rem] border-[6px] border-gray-900 bg-[#f8f7f4] overflow-hidden shadow-2xl flex flex-col">
        <!-- Notch -->
        <div class="bg-gray-900 h-7 flex items-center justify-center shrink-0">
          <div class="w-20 h-5 bg-gray-800 rounded-b-2xl"></div>
        </div>

        <!-- Header -->
        <div class="bg-[#f8f7f4] px-4 pt-4 pb-3 shrink-0">
          <h3 class="text-lg font-bold text-gray-900 tracking-tight mb-2">Produccions</h3>
          <div class="flex items-center gap-2">
            <div class="flex-1 flex items-center gap-1.5 bg-white border border-[#e5e3de] rounded-xl px-2.5 py-1.5">
              <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span class="text-xs text-gray-400">Buscar producci...</span>
            </div>
            <div class="bg-gray-900 text-white px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap shrink-0">+ Nova producció</div>
          </div>
        </div>

        <!-- Content -->
        <div class="px-3 pb-2 overflow-y-auto h-[420px]">
          <!-- Congelador -->
          <div class="border border-[#e5e3de] border-l-4 border-l-blue-500 rounded-xl bg-white overflow-hidden">
            <div class="px-4 py-2.5 bg-blue-50/60 flex items-center justify-between">
              <h4 class="text-sm font-bold text-blue-600">Congelador</h4>
              <div class="flex items-center gap-1.5">
                <span class="text-xs text-gray-500 font-medium">4 prod.</span>
                <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 15l7-7 7 7"/></svg>
              </div>
            </div>
            <div class="divide-y divide-[#e5e3de]/40">
              <!-- Croquetas -->
              <div class="px-4 py-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-gray-900">Croquetas (cong)</span>
                  <svg class="w-3.5 h-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                </div>
                <div class="text-xs text-gray-500 mb-2">Stock: <span class="font-bold text-gray-800">35</span> ud</div>
                <div class="space-y-1.5">
                  <div class="w-full py-2.5 rounded-lg border border-green-600 text-green-600 text-xs font-semibold text-center">+ Produir</div>
                  <div class="grid grid-cols-2 gap-1.5">
                    <div class="py-2.5 rounded-lg border border-red-600 text-red-600 text-xs font-semibold text-center">- Surt</div>
                    <div class="py-2.5 rounded-lg border border-blue-600 text-blue-600 text-xs font-semibold text-center">Moure</div>
                  </div>
                </div>
              </div>
              <!-- Cheesecake -->
              <div class="px-4 py-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-gray-900">Cheesecake</span>
                  <svg class="w-3.5 h-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                </div>
                <div class="text-xs text-gray-500 mb-1">Stock: <span class="font-bold text-gray-800">5</span> kg</div>
              </div>
              <!-- Helado de Vainilla -->
              <div class="px-4 py-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-gray-900">Helado de Vainilla</span>
                  <svg class="w-3.5 h-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                </div>
                <div class="text-xs text-gray-500">Stock: <span class="font-bold text-gray-800">6</span> L <span class="text-[#dc2626] font-medium ml-1">+5 caducat</span></div>
              </div>
              <!-- Sorbete de Limon -->
              <div class="px-4 py-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-gray-900">Sorbete de Limon</span>
                  <svg class="w-3.5 h-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                </div>
                <div class="text-xs text-gray-500">Stock: <span class="font-bold text-gray-300">0</span> L <span class="text-[#dc2626] font-medium ml-1">+4 caducat</span></div>
              </div>
            </div>
          </div>

          <!-- Camara -->
          <div class="border border-[#e5e3de] border-l-4 border-l-teal-500 rounded-xl bg-white overflow-hidden mt-2.5">
            <div class="px-4 py-2.5 bg-teal-50/60 flex items-center justify-between">
              <h4 class="text-sm font-bold text-teal-600">Camara</h4>
              <div class="flex items-center gap-1.5">
                <span class="text-xs text-gray-500 font-medium">2 prod.</span>
                <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 15l7-7 7 7"/></svg>
              </div>
            </div>
            <div class="divide-y divide-[#e5e3de]/40">
              <div class="px-4 py-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-gray-900">Carpaccio</span>
                  <svg class="w-3.5 h-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                </div>
                <div class="text-xs text-gray-500">Stock: <span class="font-bold text-gray-300">0</span> ud <span class="text-[#dc2626] font-medium ml-1">+21 caducat</span></div>
              </div>
              <div class="px-4 py-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-gray-900">Tataki de Atun</span>
                  <svg class="w-3.5 h-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                </div>
                <div class="text-xs text-gray-500">Stock: <span class="font-bold text-gray-300">0</span> ud <span class="text-[#dc2626] font-medium ml-1">+9 caducat</span></div>
              </div>
            </div>
          </div>

          <!-- Timbre -->
          <div class="border border-[#e5e3de] border-l-4 border-l-pink-500 rounded-xl bg-white overflow-hidden mt-2.5">
            <div class="px-4 py-2.5 bg-pink-50/60 flex items-center justify-between">
              <h4 class="text-sm font-bold text-pink-600">Timbre</h4>
              <div class="flex items-center gap-1.5">
                <span class="text-xs text-gray-500 font-medium">2 prod.</span>
                <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 15l7-7 7 7"/></svg>
              </div>
            </div>
            <div class="divide-y divide-[#e5e3de]/40">
              <div class="px-4 py-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-gray-900">Pan de coca</span>
                  <svg class="w-3.5 h-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                </div>
                <div class="text-xs text-gray-500">Stock: <span class="font-bold text-gray-800">18</span> ud</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom nav -->
        <div class="bg-gray-900/95 backdrop-blur-sm h-14 flex items-center justify-around px-3 shrink-0">
          <div class="flex flex-col items-center gap-0.5">
            <div class="relative">
              <svg class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
              <span class="absolute -top-1.5 -right-2 min-w-[14px] h-[14px] bg-[#dc2626] rounded-full text-[8px] font-bold text-white flex items-center justify-center px-0.5">45</span>
            </div>
            <span class="text-[8px] text-gray-500 font-medium">Urgent</span>
          </div>
          <div class="flex flex-col items-center gap-0.5">
            <svg class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span class="text-[8px] text-gray-500 font-medium">Lote</span>
          </div>
          <!-- FAB -->
          <div class="-mt-5">
            <div class="w-12 h-12 bg-gray-800 rounded-2xl flex items-center justify-center shadow-lg border-2 border-gray-700">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <span class="text-[8px] text-white font-semibold block text-center mt-0.5">Produccions</span>
          </div>
          <div class="flex flex-col items-center gap-0.5">
            <svg class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span class="text-[8px] text-gray-500 font-medium">Historial</span>
          </div>
          <div class="flex flex-col items-center gap-0.5">
            <svg class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span class="text-[8px] text-gray-500 font-medium">Informe</span>
          </div>
        </div>

        <!-- Home indicator -->
        <div class="bg-[#f8f7f4] h-4 flex items-center justify-center shrink-0">
          <div class="w-24 h-1 bg-gray-900 rounded-full"></div>
        </div>
      </div>
    </div>

    <!-- ==================== DESKTOP: Tablet mockup (landscape) ==================== -->
    <div class="hidden md:block mx-auto overflow-x-auto">
      <div class="min-w-[700px] max-w-[960px] mx-auto aspect-[16/10] rounded-[2rem] border-[8px] border-gray-900 bg-[#f8f7f4] overflow-hidden shadow-2xl">
        <div class="flex h-full">

          <!-- Sidebar -->
          <div class="w-[84px] bg-gray-900 flex flex-col items-center pt-4 pb-4 shrink-0">
            <div class="flex flex-col items-center gap-0.5 py-2 px-1">
              <div class="relative">
                <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
                <span class="absolute -top-2 -right-3 min-w-[18px] h-[18px] bg-[#dc2626] rounded-full text-[9px] font-bold text-white flex items-center justify-center px-1">45</span>
              </div>
              <span class="text-[10px] text-gray-500 font-medium mt-0.5">Urgent</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 py-2 px-1 bg-gray-800 rounded-xl mt-2 w-[64px]">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              <span class="text-[10px] text-white font-semibold">Produccions</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 py-2 px-1 mt-2">
              <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span class="text-[10px] text-gray-500 font-medium mt-0.5">Lote</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 py-2 px-1 mt-2">
              <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span class="text-[10px] text-gray-500 font-medium mt-0.5">Historial</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 py-2 px-1 mt-2">
