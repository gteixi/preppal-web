                    <div class="flex items-center justify-center gap-1.5">
                      <span class="px-3 py-1.5 rounded-lg border border-green-600 text-green-600 text-xs font-semibold">+ Produir</span>
                      <span class="px-3 py-1.5 rounded-lg border border-red-600 text-red-600 text-xs font-semibold">- Surt</span>
                      <span class="px-3 py-1.5 rounded-lg border border-blue-600 text-blue-600 text-xs font-semibold">Moure</span>
                    </div>
                  </div>
                  <div class="grid grid-cols-[1fr_100px_220px] items-center px-5 py-3 demo-item">
                    <div class="flex items-center gap-1.5">
                      <span class="text-base font-semibold text-gray-900">Cheesecake</span>
                      <svg class="w-3.5 h-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                    </div>
                    <div class="text-center">
                      <div><span class="text-lg font-bold tabular-nums text-gray-800">5</span> <span class="text-xs text-gray-400">kg</span></div>
                    </div>
                    <div class="flex items-center justify-center gap-1.5">
                      <span class="px-3 py-1.5 rounded-lg border border-green-600 text-green-600 text-xs font-semibold">+ Produir</span>
                      <span class="px-3 py-1.5 rounded-lg border border-red-600 text-red-600 text-xs font-semibold">- Surt</span>
                      <span class="px-3 py-1.5 rounded-lg border border-blue-600 text-blue-600 text-xs font-semibold">Moure</span>
                    </div>
                  </div>
                  <div class="grid grid-cols-[1fr_100px_220px] items-center px-5 py-3 demo-item">
                    <div class="flex items-center gap-1.5">
                      <span class="text-base font-semibold text-gray-900">Helado de Vainilla</span>
                      <svg class="w-3.5 h-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                    </div>
                    <div class="text-center">
                      <div><span class="text-lg font-bold tabular-nums text-gray-800">6</span> <span class="text-xs text-gray-400">L</span></div>
                      <div class="text-xs font-medium text-[#dc2626]">+5 L caducat</div>
                    </div>
                    <div class="flex items-center justify-center gap-1.5">
                      <span class="px-3 py-1.5 rounded-lg border border-green-600 text-green-600 text-xs font-semibold">+ Produir</span>
                      <span class="px-3 py-1.5 rounded-lg border border-red-600 text-red-600 text-xs font-semibold">- Surt</span>
                      <span class="px-3 py-1.5 rounded-lg border border-blue-600 text-blue-600 text-xs font-semibold">Moure</span>
