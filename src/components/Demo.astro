                    <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 15l7-7 7 7"/></svg>
                  </div>
                </div>
                <div class="grid grid-cols-[1fr_100px_220px] px-5 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider border-b border-[#e5e3de]/60">
