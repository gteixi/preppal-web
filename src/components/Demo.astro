              <span class="text-[10px] text-gray-500 font-medium mt-0.5">Sortir</span>
            </div>
          </div>

          <!-- Main content -->
          <div class="flex-1 min-w-0 flex flex-col overflow-hidden">
            <div class="bg-[#f8f7f4] px-8 pt-5 pb-4">
              <h3 class="text-2xl font-bold text-gray-900 tracking-tight mb-3">Produccions</h3>
              <div class="flex items-center gap-3">
                <div class="flex-1 flex items-center gap-2 bg-white border border-[#e5e3de] rounded-xl px-3 py-2">
                  <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                  <span class="text-sm text-gray-400">Buscar producció...</span>
                </div>
                <div class="bg-gray-900 text-white px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap shrink-0">+ Nova producció</div>
              </div>
