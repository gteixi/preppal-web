---
import { t, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="pt-32 pb-20 px-6">
  <div class="max-w-4xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 bg-brand-50 text-brand-700 px-4 py-1.5 rounded-full text-sm font-medium mb-8">
      <span class="w-2 h-2 bg-brand-500 rounded-full"></span>
      {t(lang, "hero.badge")}
    </div>

    <h1 class="text-5xl md:text-6xl font-bold leading-tight tracking-tight text-warm-900 mb-6">
      {t(lang, "hero.title.line1")}
      <span class="text-brand-500">{t(lang, "hero.title.highlight")}</span>
    </h1>

    <p class="text-lg md:text-xl text-warm-500 max-w-2xl mx-auto mb-10 leading-relaxed">
      {t(lang, "hero.description")}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#contact"
        class="bg-brand-500 hover:bg-brand-600 text-white px-8 py-4 rounded-xl text-lg font-semibold transition-colors w-full sm:w-auto"
      >
        {t(lang, "hero.cta.demo")}
      </a>
      <a
        href="#features"
        class="bg-white hover:bg-warm-100 text-warm-700 px-8 py-4 rounded-xl text-lg font-semibold border border-warm-200 transition-colors w-full sm:w-auto"
      >
        {t(lang, "hero.cta.features")}
      </a>
    </div>
  </div>
</section>
