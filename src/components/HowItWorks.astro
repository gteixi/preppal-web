---
import { t, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const steps = ["1", "2", "3"];
---

<section id="how-it-works" class="py-20 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">
        {t(lang, "how.title")}
      </h2>
      <p class="text-lg text-warm-500">
        {t(lang, "how.subtitle")}
      </p>
    </div>

    <div class="space-y-8">
      {steps.map((num) => (
        <div class="flex gap-6 items-start">
          <div class="shrink-0 w-14 h-14 bg-brand-500 text-white rounded-2xl flex items-center justify-center text-lg font-bold">
            0{num}
          </div>
          <div>
            <h3 class="text-xl font-bold text-warm-900 mb-1">{t(lang, `how.step${num}.title`)}</h3>
            <p class="text-warm-500 leading-relaxed">{t(lang, `how.step${num}.description`)}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
