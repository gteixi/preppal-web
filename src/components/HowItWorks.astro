---
const steps = [
  {
    number: "01",
    title: "Configura les teves produccions",
    description:
      "Defineix els productes que elabores, amb unitats, hores de vida util i a quina estacio pertanyen.",
  },
  {
    number: "02",
    title: "Registra el dia a dia",
    description:
      "Cada cop que produeixes, toca el boto i registra la quantitat. El lot i la caducitat es calculen sols.",
  },
  {
    number: "03",
    title: "Controla d'un cop d'ull",
    description:
      "El panell principal et mostra tot el stock amb codis de color. Les alertes urgents apareixen destacades.",
  },
];
---

<section id="how-it-works" class="py-20 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">
        Senzill com ha de ser
      </h2>
      <p class="text-lg text-warm-500">
        Pensat per funcionar amb guants, amb pressa i sense formacio.
      </p>
    </div>

    <div class="space-y-8">
      {steps.map((step) => (
        <div class="flex gap-6 items-start">
          <div class="shrink-0 w-14 h-14 bg-brand-500 text-white rounded-2xl flex items-center justify-center text-lg font-bold">
            {step.number}
          </div>
          <div>
            <h3 class="text-xl font-bold text-warm-900 mb-1">{step.title}</h3>
            <p class="text-warm-500 leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
