---
import { t, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const features = [
  { icon: "\u{1F4E6}", key: "stock" },
  { icon: "\u23F0", key: "expiry" },
  { icon: "\u{1F4DD}", key: "production" },
  { icon: "\u{1F4CA}", key: "history" },
  { icon: "\u2744\uFE0F", key: "freeze" },
  { icon: "\u{1F52E}", key: "predict" },
];
---

<section id="features" class="py-20 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">
        {t(lang, "features.title")}
      </h2>
      <p class="text-lg text-warm-500 max-w-2xl mx-auto">
        {t(lang, "features.subtitle")}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <div class="bg-warm-50 rounded-2xl p-8 border border-warm-200 hover:border-brand-300 transition-colors">
          <div class="text-4xl mb-4">{feature.icon}</div>
          <h3 class="text-xl font-bold text-warm-900 mb-2">{t(lang, `features.${feature.key}.title`)}</h3>
          <p class="text-warm-500 leading-relaxed">{t(lang, `features.${feature.key}.description`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
