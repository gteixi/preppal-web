---
import { t, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="contact" class="py-20 px-6">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">
        {t(lang, "contact.title")}
      </h2>
      <p class="text-lg text-warm-500">
        {t(lang, "contact.subtitle")}
      </p>
    </div>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="space-y-5"
    >
      <input type="hidden" name="access_key" value="fff2a0e5-d4c1-48ce-a41d-93091de94ce5" />
      <input type="hidden" name="redirect" value={`https://preppal.com/${lang}/gracies`} />
      <input type="checkbox" name="botcheck" class="hidden" />

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="name" class="block text-sm font-semibold text-warm-700 mb-1.5">
            {t(lang, "contact.name")}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder={t(lang, "contact.name.placeholder")}
            class="w-full px-4 py-3 rounded-xl border border-warm-200 bg-white text-warm-900 placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          />
        </div>
        <div>
          <label for="restaurant" class="block text-sm font-semibold text-warm-700 mb-1.5">
            {t(lang, "contact.restaurant")}
          </label>
          <input
            type="text"
            id="restaurant"
            name="restaurant"
            required
            placeholder={t(lang, "contact.restaurant.placeholder")}
            class="w-full px-4 py-3 rounded-xl border border-warm-200 bg-white text-warm-900 placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          />
        </div>
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-warm-700 mb-1.5">
          {t(lang, "contact.email")}
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder={t(lang, "contact.email.placeholder")}
          class="w-full px-4 py-3 rounded-xl border border-warm-200 bg-white text-warm-900 placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
        />
      </div>

      <div>
        <label for="phone" class="block text-sm font-semibold text-warm-700 mb-1.5">
          {t(lang, "contact.phone")}
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder={t(lang, "contact.phone.placeholder")}
          class="w-full px-4 py-3 rounded-xl border border-warm-200 bg-white text-warm-900 placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold text-warm-700 mb-1.5">
          {t(lang, "contact.message")}
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder={t(lang, "contact.message.placeholder")}
          class="w-full px-4 py-3 rounded-xl border border-warm-200 bg-white text-warm-900 placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full bg-brand-500 hover:bg-brand-600 text-white px-8 py-4 rounded-xl text-lg font-semibold transition-colors cursor-pointer"
      >
        {t(lang, "contact.submit")}
      </button>
    </form>
  </div>
</section>
