---
---

<section id="contact" class="py-20 px-6">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">
        Parlem?
      </h2>
      <p class="text-lg text-warm-500">
        Explica'ns sobre el teu restaurant i et prepararem una demo personalitzada.
      </p>
    </div>

    <form
      action="https://formsubmit.co/YOUR_EMAIL@example.com"
      method="POST"
      class="space-y-5"
    >
      <input type="text" name="_honey" style="display:none" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value="https://preppal.com/gracies" />

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="name" class="block text-sm font-semibold text-warm-700 mb-1.5">
            Nom
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Joan Garcia"
            class="w-full px-4 py-3 rounded-xl border border-warm-200 bg-white text-warm-900 placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          />
        </div>
        <div>
          <label for="restaurant" class="block text-sm font-semibold text-warm-700 mb-1.5">
            Restaurant
          </label>
          <input
            type="text"
            id="restaurant"
            name="restaurant"
            required
            placeholder="El Celler de Can Roca"
            class="w-full px-4 py-3 rounded-xl border border-warm-200 bg-white text-warm-900 placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          />
        </div>
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-warm-700 mb-1.5">
          Email
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="joan@elceller.cat"
          class="w-full px-4 py-3 rounded-xl border border-warm-200 bg-white text-warm-900 placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
        />
      </div>

      <div>
        <label for="phone" class="block text-sm font-semibold text-warm-700 mb-1.5">
          Telefon
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="612 345 678"
          class="w-full px-4 py-3 rounded-xl border border-warm-200 bg-white text-warm-900 placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold text-warm-700 mb-1.5">
          Missatge
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder="Explica'ns una mica sobre la teva cuina i que necessites..."
          class="w-full px-4 py-3 rounded-xl border border-warm-200 bg-white text-warm-900 placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full bg-brand-500 hover:bg-brand-600 text-white px-8 py-4 rounded-xl text-lg font-semibold transition-colors cursor-pointer"
      >
        Enviar missatge
      </button>
    </form>
  </div>
</section>
